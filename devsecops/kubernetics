###################       Some Advanced Commands   ###########################

1.Declarative Management & File Operations

# Generate a deployment YAML file template without actually creating it (Dry Run)
kubectl create deployment web-test --image=nginx --dry-run=client -o yaml > test-deploy.yaml

# Generate a service YAML template linked to a deployment (Dry Run)
kubectl expose deployment web-test --type=NodePort --port=80 --dry-run=client -o yaml > test-svc.yaml

# Delete all resources defined inside a specific configuration file
kubectl delete -f production-app.yaml

2. ConfigMap & Secret Management 

# Create a ConfigMap directly from literal key-value pairs
kubectl create configmap app-settings --from-literal=DB_HOST=10.0.0.5 --from-literal=PORT=3306

# Create a ConfigMap from an entire environment configuration file
kubectl create configmap app-file-config --from-file=config.properties

# View the actual data stored inside a ConfigMap in YAML format
kubectl get configmap app-settings -o yaml


3. Advanced Troubleshooting & Multi-Container Debugging

# View resources with real-time updates (useful during rollouts or self-healing labs)
kubectl get pods -w

# Stream logs from a specific container inside a multi-container Pod
kubectl logs sidecar-monitored-pod -c helper-sidecar-logger

# Drop into a shell of a specific container inside a multi-container Pod
kubectl exec -it sidecar-monitored-pod -c main-web-server -- /bin/sh

# Show resource utilization (CPU and Memory) of nodes and pods (Requires Metrics Server)
kubectl top nodes
kubectl top pods


4. Cluster Context & Namespace Navigation

# List all namespaces available in your cluster
kubectl get namespaces

# List pods running inside a specific namespace (e.g., kube-system)
kubectl get pods -n kube-system

# Create a brand new namespace for an assignment
kubectl create namespace cdac-lab

# List pods across ALL namespaces simultaneously
kubectl get pods --all-namespaces












