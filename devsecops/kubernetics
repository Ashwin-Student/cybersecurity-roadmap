*************************Volume & Data Storage Lifecycle ********************
apiVersion: v1
kind: Pod
metadata:
  name: secure-storage-pod
spec:
  volumes:
  - name: host-filesystem-link
    hostPath:
      path: /data/analytics-logs   # The actual path on your host node machine
      type: DirectoryOrCreate
  containers:
  - name: processing-engine
    image: alpine
    command: ["/bin/sh", "-c", "echo 'Log entry' >> /mnt/logs/app.log"]
    volumeMounts:
    - name: host-filesystem-link
      mountPath: /mnt/logs        # The path where it gets mounted inside the container

