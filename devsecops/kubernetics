************************Installation of Kubernetics********************
# Step 1: Download latest stable kubectl binary
curl -LO "https://k8s.io(curl -L -s https://k8s.io)/bin/linux/amd64/kubectl"
sudo install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl

# Step 2: Download and install Minikube
curl -LO https://googleapis.com
sudo install minikube-linux-amd64 /usr/local/bin/minikube

# Step 3: Start cluster using docker virtualization driver
minikube start --driver=docker



**********************Installation Verification*********************
# Check CLI version and API connectivity
kubectl version --client --output=yaml

# Verify general health of control components
kubectl cluster-info

# List active compute nodes available in the cluster context
kubectl get nodes




*******************Exposing PORTS Using a Service********************
# Expose the webapp deployment to the outside world using NodePort
kubectl expose deployment live-webapp --type=NodePort --port=80 --target-port=80


# Local Minikube Command to open service in browser automatically
minikube service live-webapp




******************Rollouts & Rollbacks ***********************
# 1. Update application image to a newer version (Triggers Rollout)
kubectl set image deployment/live-webapp nginx=nginx:1.25-alpine

# 2. Track real-time progress status of the rollout
kubectl rollout status deployment/live-webapp

# 3. Inspect historical record of image updates
kubectl rollout history deployment/live-webapp

# 4. CRITICAL RECOVERY: Undo an update and roll back immediately to the last working version
kubectl rollout undo deployment/live-webapp



**************Self-Healing Verification****************
# Step 1: Monitor pods
kubectl get pods

# Step 2: Delete a running pod deliberately
kubectl delete pod <active-pod-name>

# Step 3: Instantly re-list pods. Notice K8s spawned a new replacement Pod within milliseconds
kubectl get pods


# Scale deployment out to 5 concurrent identical pods
kubectl scale deployment live-webapp --replicas=5

# Verify scaling capacity adjustment status
kubectl get deployments








********************Declarative Architecture (YAML Configs)************************

apiVersion: apps/v1
kind: Deployment
metadata:
  name: dynamic-webapp-deployment
  labels:
    tier: frontend
spec:
  replicas: 3
  selector:
    matchLabels:
      run: web-node
  template:
    metadata:
      labels:
        run: web-node
    spec:
      containers:
      - name: primary-web-container
        image: nginx:alpine
        ports:
        - containerPort: 80
---
apiVersion: v1
kind: Service
metadata:
  name: webapp-access-service
spec:
  type: NodePort
  selector:
    run: web-node
  ports:
    - port: 8080        # Port exposed inside the cluster
      targetPort: 80    # Target port the container is listening on
      nodePort: 30080   # Port mapped on the physical host machine node


# Apply the complete declarative manifest to the cluster
kubectl apply -f production-app.yaml







