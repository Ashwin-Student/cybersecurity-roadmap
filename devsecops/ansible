***************************** Installing App on Remote Server*******************************
---
- name: Install Nginx Web Server
  hosts: webservers
  become: true
  tasks:
    - name: Ensure Nginx is installed
      ansible.builtin.apt:
        name: nginx
        state: present
        update_cache: yes

*****************************Copying Files on Remote Server*****************************

    - name: Copy index.html configuration file
      ansible.builtin.copy:
        src: /local/path/index.html
        dest: /var/www/html/index.html

******************************Backup of Files on Remote Server******************

    - name: Copy config file with backup enabled
      ansible.builtin.copy:
        src: app.conf
        dest: /etc/app.conf
        backup: yes




****************************** Create, Delete & Permission on Remote Server***********************

    - name: Create a new directory with specific permissions
      ansible.builtin.file:
        path: /var/www/my_app
        state: directory
        mode: '0755'
        owner: ubuntu
        group: ubuntu

    - name: Delete a specific file
      ansible.builtin.file:
        path: /tmp/old_log.txt
        state: absent




****************************Run Script Remotely*************************]

    - name: Execute a local cleanup script on remote nodes
      ansible.builtin.script: /local/scripts/cleanup.sh



****************************Add Cron Job Remotely************************

    - name: Schedule an database backup every day at 2 AM
      ansible.builtin.cron:
        name: "Daily DB Backup"
        minute: "0"
        hour: "2"
        job: "/usr/local/bin/backup_db.sh"


******************************Create User on Remote Server**********************

    - name: Create a DevOps engineer user account
      ansible.builtin.user:
        name: cdac_user
        shell: /bin/bash
        groups: sudo
        append: yes



****************************Add or Update Password*********************


    - name: Create user with a secure password hash
      ansible.builtin.user:
        name: test_user
        password: "$6$rounds=656000$saltsaltsalt$H8x...[your-hashed-password-here]"


*******************************Find and Stop Process*******************

    - name: Stop a specific application process gracefully
      ansible.builtin.shell: pkill -f "my_buggy_app"
      ignore_errors: yes


********************** Download Files on Remote Server***********************

    - name: Download application package from remote URL
      ansible.builtin.get_url:
        url: https://example.com
        dest: /tmp/software.tar.gz
        mode: '0644'


************************ Enable Service in Firewall********************


    - name: Allow incoming HTTP traffic through UFW
      community.general.ufw:
        rule: allow
        port: '80'
        proto: tcp



************************** Run Tasks as SUDO User*****************

- name: System maintenance play
  hosts: webservers
  become: true # Escalates privileges for all tasks within this play
  tasks:
    - name: Restart system clock service
      ansible.builtin.systemd:
        name: systemd-timesyncd
        state: restarted








***********************Ad Hoc Task with Ansible**********************


# General Syntax: ansible [group] -i [inventory] -m [module] -a [arguments]

# Check disk space on all targets
ansible all -i hosts.ini -m shell -a "df -h"

# Restart Nginx immediately
ansible webservers -i hosts.ini -m systemd -a "name=nginx state=restarted" --become










