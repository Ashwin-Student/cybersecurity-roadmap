****************************Ansible Variables**********************
---
- name: Variable Practice Playbook
  hosts: localhost
  vars:
    app_port: 8080
    app_dir: "/var/www/app"
  tasks:
    - name: Display custom port configuration
      ansible.builtin.debug:
        msg: "The application is running on port {{ app_port }} in directory {{ app_dir }}"







*****************************Ansible Handlers********************
  tasks:
    - name: Update Nginx virtual host configuration
      ansible.builtin.copy:
        src: nginx.conf
        dest: /etc/nginx/nginx.conf
      notify: Restart Nginx Service

  handlers:
    - name: Restart Nginx Service
      ansible.builtin.systemd:
        name: nginx
        state: restarted






***************************Ansible Conditions************************
    - name: Install Apache on Ubuntu environments
      ansible.builtin.apt:
        name: apache2
        state: present
      when: ansible_facts['os_family'] == "Debian"

    - name: Install Apache on RedHat environments
      ansible.builtin.dnf:
        name: httpd
        state: present
      when: ansible_facts['os_family'] == "RedHat"



